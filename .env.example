# Copy this file to .env and fill in real values. Never commit .env.

# Port the app listens on.
PORT=7722

# MariaDB / MySQL connection.
# With docker compose the host is set to the "db" service automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webssh
DB_PASSWORD=change-me-please
DB_NAME=webssh

# Extra hostnames the app may be reached by (comma separated, names only, no port).
# localhost and IP addresses are always allowed. Needed behind a reverse proxy,
# for example: ALLOWED_HOSTS=ssh.example.com
ALLOWED_HOSTS=

# 64 hex characters. Encrypts saved device passwords. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and back it up separately: if you lose it, saved
# device passwords cannot be recovered.
ENCRYPTION_KEY=
