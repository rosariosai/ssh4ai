# Copy this file to .env and fill in real values. Never commit .env.

# Port the app listens on.
PORT=7722

# MariaDB / MySQL connection.
# With docker compose the host is set to the "db" service automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=webssh
DB_PASSWORD=change-me-please
DB_NAME=webssh

# Extra hostnames the app may be reached by (comma separated, names only, no port).
# localhost and IP addresses are always allowed. Needed behind a reverse proxy,
# for example: ALLOWED_HOSTS=ssh.example.com
ALLOWED_HOSTS=

# 64 hex characters. Encrypts saved device passwords. Required.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret and back it up separately: if you lose it, saved
# device passwords cannot be recovered.
ENCRYPTION_KEY=

# ---- Optional access protection (all off when unset) ----
# Shared-password login. Make the value with:  node tools/hash-password.js
# (or set the password in the app under Settings > Security instead).
#APP_PASSWORD_HASH=
# Only these IPs / CIDR ranges may reach the app, e.g. 192.0.2.0/24,198.51.100.7
#ALLOWED_CIDRS=
# Your reverse proxy's address(es), so the real client IP is read from X-Forwarded-For.
#TRUSTED_PROXIES=
# Extra browser origins allowed to use the app (same host is always allowed).
#ALLOWED_ORIGINS=
#SESSION_IDLE_MINUTES=30
#SESSION_MAX_HOURS=12
# auto (default) | always | never
#COOKIE_SECURE=auto
# Recovery: set to 1 for one start to clear the login and allowlist saved from the panel.
#ACCESS_RESET=1
